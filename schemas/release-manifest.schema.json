{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoStream Release Manifest",
  "description": "Published as release-manifest.json with release-manifest.json.sha256 containing 64 lowercase hexadecimal characters, two spaces, the filename, and a trailing newline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "channel", "published_at", "minimum_agent_version", "components"],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[.-][0-9A-Za-z.-]+)?$" },
    "channel": { "enum": ["host", "docker"] },
    "published_at": { "type": "string", "format": "date-time" },
    "bundle_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[.-][0-9A-Za-z.-]+)?$",
      "description": "Docker compatibility alias. It must equal release_id."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Docker compatibility alias. It must equal published_at."
    },
    "minimum_agent_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "source_version"],
        "properties": {
          "service": { "enum": ["control-panel", "discord-bot", "encoder-recorder", "observability", "worker"] },
          "source_version": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[.-][0-9A-Za-z.-]+)?$",
            "description": "For host releases this must equal release_id."
          },
          "commit": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" },
          "image": { "type": "string" },
          "manifest_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["os", "arch", "name", "size", "sha256"],
              "properties": {
                "os": { "const": "linux" },
                "arch": { "enum": ["amd64", "arm64"] },
                "name": {
                  "type": "string",
                  "pattern": "^autostream-(?:control-panel|discord-bot|encoder-recorder|observability|worker)_v[0-9]+\\.[0-9]+\\.[0-9]+(?:[.-][0-9A-Za-z.-]+)?_linux_(?:amd64|arm64)\\.tar\\.gz$",
                  "description": "The prefix must match service and the embedded version must equal source_version/release_id."
                },
                "size": { "type": "integer", "minimum": 1, "maximum": 268435456 },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "Raw lowercase archive digest; the matching .sha256 sidecar uses the same digest and exact artifact filename."
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "arch": { "const": "amd64" } }, "required": ["arch"] },
                  "then": { "properties": { "name": { "pattern": "_linux_amd64\\.tar\\.gz$" } } }
                },
                {
                  "if": { "properties": { "arch": { "const": "arm64" } }, "required": ["arch"] },
                  "then": { "properties": { "name": { "pattern": "_linux_arm64\\.tar\\.gz$" } } }
                }
              ]
            }
          },
          "platform_digests": {
            "type": "object",
            "additionalProperties": false,
            "required": ["linux/amd64", "linux/arm64"],
            "properties": {
              "linux/amd64": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "linux/arm64": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          },
          "rollback_compatible": { "type": "boolean" },
          "database_schema": { "enum": ["none", "backward_compatible", "irreversible"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "channel": { "const": "docker" } },
        "required": ["channel"]
      },
      "then": {
        "required": ["bundle_version", "generated_at", "minimum_agent_version"],
        "properties": {
          "components": {
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "required": [
                "service", "source_version", "image", "manifest_digest", "platform_digests",
                "rollback_compatible", "database_schema"
              ],
              "properties": {
                "image": {
                  "type": "string",
                  "pattern": "^ghcr\\.io/kome-lab/autostream-docker/(?:control-panel|discord-bot|encoder-recorder|observability|worker):v[0-9]+\\.[0-9]+\\.[0-9]+(?:[.-][0-9A-Za-z.-]+)?$",
                  "description": "The repository suffix must equal service and the tag must equal release_id/bundle_version."
                },
                "rollback_compatible": { "const": true },
                "database_schema": { "enum": ["none", "backward_compatible"] }
              },
              "not": {
                "anyOf": [
                  { "required": ["commit"] },
                  { "required": ["artifacts"] }
                ]
              },
              "allOf": [
                {
                  "if": { "properties": { "service": { "const": "control-panel" } }, "required": ["service"] },
                  "then": {
                    "properties": {
                      "image": { "pattern": "^ghcr\\.io/kome-lab/autostream-docker/control-panel:" },
                      "database_schema": { "const": "backward_compatible" }
                    }
                  }
                },
                {
                  "if": { "properties": { "service": { "const": "discord-bot" } }, "required": ["service"] },
                  "then": {
                    "properties": {
                      "image": { "pattern": "^ghcr\\.io/kome-lab/autostream-docker/discord-bot:" },
                      "database_schema": { "const": "none" }
                    }
                  }
                },
                {
                  "if": { "properties": { "service": { "const": "encoder-recorder" } }, "required": ["service"] },
                  "then": {
                    "properties": {
                      "image": { "pattern": "^ghcr\\.io/kome-lab/autostream-docker/encoder-recorder:" },
                      "database_schema": { "const": "none" }
                    }
                  }
                },
                {
                  "if": { "properties": { "service": { "const": "observability" } }, "required": ["service"] },
                  "then": {
                    "properties": {
                      "image": { "pattern": "^ghcr\\.io/kome-lab/autostream-docker/observability:" },
                      "database_schema": { "const": "backward_compatible" }
                    }
                  }
                },
                {
                  "if": { "properties": { "service": { "const": "worker" } }, "required": ["service"] },
                  "then": {
                    "properties": {
                      "image": { "pattern": "^ghcr\\.io/kome-lab/autostream-docker/worker:" },
                      "database_schema": { "const": "none" }
                    }
                  }
                }
              ]
            },
            "allOf": [
              { "contains": { "properties": { "service": { "const": "control-panel" } }, "required": ["service"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "service": { "const": "discord-bot" } }, "required": ["service"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "service": { "const": "encoder-recorder" } }, "required": ["service"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "service": { "const": "observability" } }, "required": ["service"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "service": { "const": "worker" } }, "required": ["service"] }, "minContains": 1, "maxContains": 1 }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "channel": { "const": "host" } },
        "required": ["channel"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["bundle_version"] },
            { "required": ["generated_at"] }
          ]
        },
        "properties": {
          "components": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "required": [
                "service", "source_version", "commit", "artifacts",
                "rollback_compatible", "database_schema"
              ],
              "not": {
                "anyOf": [
                  { "required": ["image"] },
                  { "required": ["manifest_digest"] },
                  { "required": ["platform_digests"] }
                ]
              },
              "properties": {
                "rollback_compatible": { "const": true },
                "database_schema": { "enum": ["none", "backward_compatible"] },
                "artifacts": {
                  "minItems": 2,
                  "maxItems": 2,
                  "allOf": [
                    {
                      "contains": {
                        "properties": { "arch": { "const": "amd64" } },
                        "required": ["arch"]
                      },
                      "minContains": 1,
                      "maxContains": 1
                    },
                    {
                      "contains": {
                        "properties": { "arch": { "const": "arm64" } },
                        "required": ["arch"]
                      },
                      "minContains": 1,
                      "maxContains": 1
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "service": { "enum": ["control-panel", "observability"] }
                    },
                    "required": ["service"]
                  },
                  "then": {
                    "properties": {
                      "database_schema": { "const": "backward_compatible" }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "service": { "enum": ["discord-bot", "encoder-recorder", "worker"] }
                    },
                    "required": ["service"]
                  },
                  "then": {
                    "properties": {
                      "database_schema": { "const": "none" }
                    }
                  }
                },
                {
                  "if": { "properties": { "service": { "const": "control-panel" } }, "required": ["service"] },
                  "then": { "properties": { "artifacts": { "items": { "properties": { "name": { "pattern": "^autostream-control-panel_" } } } } } }
                },
                {
                  "if": { "properties": { "service": { "const": "discord-bot" } }, "required": ["service"] },
                  "then": { "properties": { "artifacts": { "items": { "properties": { "name": { "pattern": "^autostream-discord-bot_" } } } } } }
                },
                {
                  "if": { "properties": { "service": { "const": "encoder-recorder" } }, "required": ["service"] },
                  "then": { "properties": { "artifacts": { "items": { "properties": { "name": { "pattern": "^autostream-encoder-recorder_" } } } } } }
                },
                {
                  "if": { "properties": { "service": { "const": "observability" } }, "required": ["service"] },
                  "then": { "properties": { "artifacts": { "items": { "properties": { "name": { "pattern": "^autostream-observability_" } } } } } }
                },
                {
                  "if": { "properties": { "service": { "const": "worker" } }, "required": ["service"] },
                  "then": { "properties": { "artifacts": { "items": { "properties": { "name": { "pattern": "^autostream-worker_" } } } } } }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
