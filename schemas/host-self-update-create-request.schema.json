{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host Self Update Create Request",
  "description": "Requests one server-resolved immutable Host Agent release. The execution host is selected only by the path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_version", "idempotency_key"],
  "properties": {
    "target_version": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128,
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    }
  }
}
