{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SystemUpdatePullOwnershipActivateRequest",
  "description": "Administrative compare-and-swap request that activates one already-verified pull_v2 Host Agent. Every expected value is required and no client-selected replacement owner or epoch is accepted.",
  "type": "object",
  "required": [
    "expected_execution_host_id",
    "expected_ownership_epoch",
    "expected_source_policy_revision",
    "expected_projection_revision",
    "expected_local_executor_policy_revision",
    "expected_local_executor_policy_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "expected_execution_host_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
    },
    "expected_ownership_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775806
    },
    "expected_source_policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_projection_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_local_executor_policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_local_executor_policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
