{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/media-upload-session.schema.json",
  "title": "MediaUploadSession",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner_type",
    "expires_at",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "owner_type": {
      "enum": [
        "upload_draft",
        "stream"
      ]
    },
    "claimed_stream_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
