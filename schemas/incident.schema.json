{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident",
  "type": "object",
  "required": ["id", "rule", "severity", "status", "summary_ja", "service_id", "diagnostic_report", "opened_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "rule": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["info", "warning", "error", "critical"] },
    "status": { "enum": ["open", "acknowledged", "investigating", "mitigated", "resolved", "ignored"] },
    "summary_ja": { "type": "string" },
    "service_id": { "type": "string" },
    "stream_id": { "type": "string" },
    "signal_id": { "type": "string" },
    "diagnostic_report": { "$ref": "#/$defs/diagnostic_report" },
    "opened_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "diagnostic_report": {
      "type": "object",
      "required": ["summary", "likely_cause", "confidence", "evidence", "impact", "recommended_actions"],
      "additionalProperties": true,
      "properties": {
        "summary": { "type": "string" },
        "likely_cause": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "impact": { "type": "string" },
        "recommended_actions": { "type": "array", "items": { "type": "string" } },
        "safe_auto_remediation_candidates": { "type": "array", "items": { "type": "string" } },
        "actions_requiring_approval": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
