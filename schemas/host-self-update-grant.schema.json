{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host Self Update Grant",
  "description": "Short-lived single-logical-consume authorization bound to one exact self-update attempt and executor plan. No credential is persisted in this receipt.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["operation", "consumed_at"],
        "properties": {
          "operation": { "const": "stage" }
        }
      },
      "then": {
        "required": ["stage_claim_revision", "stage_claimed_at"]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["stage_claim_revision"] },
            { "required": ["stage_claimed_at"] }
          ]
        }
      }
    }
  ],
  "required": [
    "id",
    "self_update_id",
    "attempt_generation",
    "operation",
    "execution_host_id",
    "agent_service_id",
    "expected_self_update_revision",
    "expected_ownership_epoch",
    "expected_source_policy_revision",
    "expected_projection_revision",
    "expected_local_executor_policy_revision",
    "expected_local_executor_policy_sha256",
    "agent_version",
    "executor_version",
    "release_commit",
    "artifact_sha256",
    "agent_protocol_version",
    "executor_protocol_version",
    "mutation_protocol_version",
    "recovery_protocol_version",
    "release",
    "directive_issued_at",
    "plan_sha256",
    "session_id",
    "revision",
    "issued_at",
    "expires_at",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "self_update_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "attempt_generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "operation": {
      "enum": ["stage", "reconcile"]
    },
    "execution_host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
    },
    "agent_service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "expected_self_update_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_ownership_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "expected_source_policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_projection_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_local_executor_policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_local_executor_policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "agent_version": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128,
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "executor_version": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128,
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "release_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "agent_protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "executor_protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "mutation_protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "recovery_protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "release": {
      "$ref": "host-self-update-release-binding.schema.json"
    },
    "directive_issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "stage_claim_revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage_claimed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
