{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System Update Job",
  "description": "Control Panel job projection. protocol_version 2 is pull-only, capability-bound, revision-fenced, and represents ambiguous execution outcomes explicitly.",
  "x-autostream-contract-major": 2,
  "x-autostream-v2-transition-compatibility": {
    "owner": "V2-COMPAT-EOL-CONTRACTS-001",
    "removal_wave": "Execution Bundle 8",
    "final_state": "absent"
  },
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "dockerPortReconfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "published_host_ip",
        "old_published_port", "new_published_port",
        "old_container_port", "new_container_port",
        "old_health_port", "new_health_port",
        "approved_compose_config_sha256", "approved_compose_revision",
        "expected_version_env_sha256", "expected_container_id",
        "expected_image_id", "expected_repository_digest"
      ],
      "properties": {
        "published_host_ip": { "const": "127.0.0.1" },
        "old_published_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "new_published_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "old_container_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "new_container_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "old_health_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "new_health_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "approved_compose_config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "approved_compose_revision": { "type": "integer", "minimum": 1 },
        "expected_version_env_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "expected_container_id": { "type": "string", "pattern": "^[a-f0-9]{12,64}$" },
        "expected_image_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "expected_repository_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "description": "Immutable Docker runtime binding. The server additionally requires old_health_port to equal old_published_port, new_health_port to equal new_published_port, and at least one of advertised, published, or container port to change."
    },
    "portReconfigurationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_namespace", "protocol", "old_port", "new_port",
        "expected_endpoint_revision", "target_endpoint_revision",
        "expected_config_revision", "target_config_revision",
        "expected_config_sha256", "target_config_sha256",
        "expected_source_policy_revision", "expected_updater_policy_revision",
        "expected_executor_policy_revision", "expected_executor_policy_sha256",
        "port_plan_sha256"
      ],
      "properties": {
        "network_namespace": { "const": "host" },
        "protocol": { "const": "tcp" },
        "old_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "new_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "expected_endpoint_revision": { "type": "integer", "minimum": 1 },
        "target_endpoint_revision": { "type": "integer", "minimum": 1 },
        "expected_config_revision": { "type": "integer", "minimum": 1 },
        "target_config_revision": { "type": "integer", "minimum": 1 },
        "expected_config_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "target_config_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "expected_source_policy_revision": { "type": "integer", "minimum": 1 },
        "expected_updater_policy_revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Host Agent projection revision used as the ownership, job, and mutation-grant fence."
        },
        "expected_executor_policy_revision": { "type": "integer", "minimum": 1 },
        "expected_executor_policy_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "port_plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Stable server-derived port intent digest in a job or claim."
        },
        "docker": { "$ref": "#/$defs/dockerPortReconfiguration" },
        "result": {
          "enum": ["applied", "rolled_back", "unchanged", "rollback_failed"]
        }
      }
    },
    "systemUpdateJobSafeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "protocol_version_unsupported", "issuer_authentication_failed", "updater_identity_mismatch",
            "authorization_expired", "authorization_replayed", "idempotency_payload_conflict",
            "capability_missing", "revision_conflict", "stale_fence", "command_expired",
            "outcome_ambiguous", "local_journal_unavailable", "execution_failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\r\\n\\t]*$"
        },
        "retryable": { "type": "boolean" },
        "audit_correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["operation"],
        "properties": {
          "operation": { "const": "port_reconfigure" }
        }
      },
      "then": {
        "required": [
          "port_reconfigure", "transport_mode", "ownership_epoch", "policy_revision"
        ],
        "properties": {
          "target_type": {
            "enum": ["discord_bot", "encoder_recorder", "observability", "worker"]
          },
          "transport_mode": { "const": "pull_v2" },
          "policy_revision": { "minimum": 1 }
        },
        "oneOf": [
          {
            "properties": {
              "deployment_mode": { "const": "systemd" },
              "port_reconfigure": {
                "not": { "required": ["docker"] },
                "properties": {
                  "old_port": { "minimum": 1024 },
                  "new_port": { "minimum": 1024 }
                }
              }
            }
          },
          {
            "properties": {
              "deployment_mode": { "const": "docker" },
              "port_reconfigure": { "required": ["docker"] }
            }
          }
        ]
      },
      "else": {
        "not": { "required": ["port_reconfigure"] }
      }
    },
    {
      "if": {
        "required": ["transport_mode"],
        "properties": {
          "transport_mode": { "const": "pull_v2" }
        }
      },
      "then": {
        "required": ["ownership_epoch", "policy_revision"],
        "properties": {
          "policy_revision": { "minimum": 1 }
        }
      }
    },
    {
      "if": {
        "required": ["port_reconfigure"],
        "properties": {
          "port_reconfigure": { "required": ["result"] }
        }
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "status": { "const": "succeeded" },
              "port_reconfigure": {
                "properties": {
                  "result": { "enum": ["applied", "unchanged"] }
                }
              }
            }
          },
          {
            "properties": {
              "status": { "const": "rolled_back" },
              "port_reconfigure": {
                "properties": {
                  "result": { "const": "rolled_back" }
                }
              }
            }
          },
          {
            "properties": {
              "status": { "const": "failed" },
              "port_reconfigure": {
                "properties": {
                  "result": { "const": "rollback_failed" }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": { "required": ["protocol_version"] },
      "then": {
        "required": [
          "protocol_version", "transport_mode", "updater_id", "desired_revision",
          "fence", "outcome", "required_capability", "authorization_id",
          "canonical_payload_digest", "automatic_resend_allowed"
        ],
        "properties": {
          "transport_mode": { "const": "pull_v2" },
          "lease_generation": { "minimum": 1 },
          "fence": { "minimum": 1 }
        },
        "oneOf": [
          {
            "required": ["operation"],
            "properties": {
              "operation": { "const": "port_reconfigure" },
              "required_capability": { "const": "host.port" }
            }
          },
          {
            "required": ["operation"],
            "properties": {
              "operation": { "const": "software_update" },
              "required_capability": { "const": "host.update" }
            }
          },
          {
            "not": { "required": ["operation"] },
            "properties": { "required_capability": { "const": "host.update" } }
          }
        ],
        "not": {
          "anyOf": [
            { "required": ["code"] },
            { "required": ["message"] }
          ]
        }
      }
    },
    {
      "if": { "required": ["protocol_version"] },
      "then": {
        "oneOf": [
          {
            "properties": {
              "outcome": { "const": "pending" },
              "status": {
                "enum": [
                  "queued", "claimed", "downloading", "verifying", "staging", "stopping",
                  "installing", "starting", "health_checking", "rolling_back"
                ]
              }
            },
            "not": { "required": ["safe_error"] }
          },
          {
            "properties": { "outcome": { "const": "succeeded" }, "status": { "const": "succeeded" } },
            "not": { "required": ["safe_error"] }
          },
          {
            "properties": { "outcome": { "const": "rolled_back" }, "status": { "const": "rolled_back" } }
          },
          {
            "properties": { "outcome": { "const": "canceled" }, "status": { "const": "canceled" } }
          },
          {
            "properties": { "outcome": { "const": "failed" }, "status": { "const": "failed" } },
            "required": ["safe_error"]
          },
          {
            "properties": {
              "outcome": { "const": "ambiguous" },
              "status": { "const": "reconciling" },
              "safe_error": {
                "required": ["code"],
                "properties": { "code": { "const": "outcome_ambiguous" } }
              }
            },
            "required": ["safe_error"]
          }
        ]
      }
    }
  ],
  "required": [
    "id", "target_id", "target_type", "host_id", "deployment_mode", "current_version", "target_version",
    "strategy", "status", "idempotency_key",
    "lease_generation", "sequence", "progress", "created_at", "updated_at"
  ],
  "properties": {
    "protocol_version": { "const": 2 },
    "operation": {
      "enum": ["software_update", "port_reconfigure"],
      "default": "software_update"
    },
    "port_reconfigure": { "$ref": "#/$defs/portReconfigurationPlan" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "target_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "target_type": {
      "enum": ["control_panel", "discord_bot", "encoder_recorder", "observability", "worker"]
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
    },
    "transport_mode": { "enum": ["ssh_v1", "pull_v2"] },
    "ownership_epoch": { "type": "integer", "minimum": 1 },
    "policy_revision": { "type": "integer", "minimum": 0 },
    "deployment_mode": { "enum": ["systemd", "docker"] },
    "current_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$" },
    "target_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$" },
    "strategy": { "enum": ["when_idle", "maintenance"] },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "status": {
      "enum": [
        "queued", "claimed", "downloading", "verifying", "staging", "stopping",
        "installing", "starting", "health_checking", "rolling_back", "reconciling",
        "succeeded", "rolled_back", "failed", "canceled"
      ]
    },
    "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
    "sequence": { "type": "integer", "minimum": 0 },
    "code": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9_.-]+$" },
    "message": { "type": "string", "maxLength": 500 },
    "artifact_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "previous_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "updater_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "authorization_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "canonical_payload_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "automatic_resend_allowed": { "const": false },
    "desired_revision": { "type": "integer", "minimum": 1 },
    "fence": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["pending", "succeeded", "failed", "rolled_back", "canceled", "ambiguous"] },
    "required_capability": {
      "enum": [
        "host.systemd", "host.docker", "host.update", "host.bootstrap",
        "host.port", "host.self_update"
      ]
    },
    "safe_error": { "$ref": "#/$defs/systemUpdateJobSafeError" },
    "requested_by": { "type": "string" },
    "lease_generation": { "type": "integer", "minimum": 0 },
    "lease_expires_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "claimed_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "canceled_at": { "type": "string", "format": "date-time" }
  }
}
