{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/oauth-user-link.schema.json",
  "title": "OAuthUserLink",
  "type": "object",
  "required": ["id", "user_id", "provider_id", "provider_type", "subject", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "user_id": { "type": "string" },
    "provider_id": { "type": "string" },
    "provider_type": { "type": "string", "enum": ["google", "github", "discord"] },
    "subject": {
      "type": "string",
      "description": "Stable provider subject. It is not a secret, but manual link creation should not be exposed in normal UI."
    },
    "email": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
