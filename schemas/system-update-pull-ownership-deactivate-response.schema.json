{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SystemUpdatePullOwnershipDeactivateResponse",
  "description": "Server-owned ssh_v1 execution-host ownership and unchanged pull policy fences returned after atomic deactivation. agent_service_id is the server-preserved legacy updater, while the pull updater identified by updater_id is returned to observer epoch zero. No credential or secret is returned.",
  "x-autostream-contract-major": 2,
  "x-autostream-v2-transition-compatibility": {
    "owner": "V2-COMPAT-EOL-CONTRACTS-001",
    "removal_wave": "Execution Bundle 8",
    "final_state": "absent",
    "purpose": "whole_release_rollback_only"
  },
  "type": "object",
  "required": [
    "updater_id",
    "execution_host_id",
    "transport_mode",
    "agent_service_id",
    "ownership_epoch",
    "agent_ownership_epoch",
    "source_policy_revision",
    "projection_revision",
    "local_executor_policy_revision",
    "local_executor_policy_sha256"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "required": ["protocol_version"] },
      "then": {
        "required": [
          "protocol_version", "idempotency_key", "desired_revision", "applied_revision",
          "fence", "capability", "rollback_transition"
        ]
      }
    }
  ],
  "properties": {
    "protocol_version": { "const": 2 },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "desired_revision": { "type": "integer", "minimum": 1 },
    "applied_revision": { "type": "integer", "minimum": 1 },
    "fence": { "type": "integer", "minimum": 1 },
    "capability": { "const": "host.update" },
    "rollback_transition": { "const": true },
    "updater_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "execution_host_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
    },
    "transport_mode": {
      "const": "ssh_v1"
    },
    "agent_service_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "ownership_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "agent_ownership_epoch": {
      "const": 0
    },
    "source_policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "projection_revision": {
      "type": "integer",
      "minimum": 1
    },
    "local_executor_policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "local_executor_policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
