{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/service-notification-email-response.schema.json",
  "title": "ServiceNotificationEmailResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "recipient_count"],
  "properties": {
    "status": {
      "const": "sent",
      "description": "The configured SMTP server accepted the message delivery attempt."
    },
    "recipient_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Number of recipients submitted without returning their addresses."
    }
  }
}
