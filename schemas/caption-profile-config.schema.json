{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptionProfileConfig",
  "type": "object",
  "required": ["provider", "model", "language", "api_key_secret_name"],
  "additionalProperties": false,
  "properties": {
    "provider": {
      "const": "deepgram",
      "description": "Live captions are generated by Deepgram; manual caption input is not a runtime provider."
    },
    "model": { "const": "nova-3" },
    "language": { "enum": ["ja", "en"] },
    "api_key_secret_name": {
      "const": "deepgram_api_key",
      "description": "Reference to the Control Panel managed secret. The raw Deepgram API key is never stored in profile JSON or returned to the frontend."
    },
    "endpointing_ms": { "type": "integer", "minimum": 10, "maximum": 5000, "default": 300 },
    "interim_results": { "type": "boolean", "default": true },
    "smart_format": { "type": "boolean", "default": true },
    "delay_ms": { "type": "integer", "minimum": 0, "maximum": 10000, "default": 800 }
  }
}
