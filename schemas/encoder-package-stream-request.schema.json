{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/encoder-package-stream-request.schema.json",
  "title": "EncoderPackageStreamRequest",
  "type": "object",
  "required": ["stream_id", "archive_run_id", "name", "started_at"],
  "additionalProperties": false,
  "dependentRequired": {
    "archive_run_id": ["started_at"]
  },
  "properties": {
    "stream_id": { "type": "string", "minLength": 1 },
    "archive_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": { "pattern": "\\.\\." },
      "description": "Stable identifier for the broadcast/archive run being packaged."
    },
    "name": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "dry_run": { "type": "boolean" }
  }
}
