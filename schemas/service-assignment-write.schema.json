{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/service-assignment-write.schema.json",
  "title": "ServiceAssignmentWriteRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["stream_id"],
  "properties": {
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "assignment_role": {
      "type": "string",
      "enum": ["primary", "standby"],
      "default": "primary",
      "description": "primary is dispatched on stream start; standby is kept as a failover candidate."
    }
  }
}
