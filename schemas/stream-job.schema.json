{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreamJob",
  "type": "object",
  "required": ["id", "name", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["created", "starting", "live", "stopping", "completed", "failed"] },
    "archive_run_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "not": { "pattern": "\\.\\." } },
    "archive_started_at": { "type": "string", "format": "date-time" },
    "archive_reported_at": { "type": "string", "format": "date-time" },
    "discord_config_id": { "type": "string", "description": "Control Panel managed Discord Bot Config used for this stream." },
    "discord_guild_id": { "type": "string", "description": "Resolved or saved stream-specific Discord guild override." },
    "discord_voice_channel_id": { "type": "string", "description": "Resolved or saved stream-specific Discord voice channel override." },
    "discord_text_channel_id": { "type": "string", "description": "Resolved or saved stream-specific Discord text channel override." },
    "encoder_profile_id": { "type": "string" },
    "caption_profile_id": { "type": "string" },
    "overlay_profile_id": { "type": "string" },
    "encoder_audio_gain_db": { "type": "number", "minimum": -60, "maximum": 24, "default": 0 },
    "archive_profile_id": { "type": "string" },
    "youtube_output_id": { "type": "string" },
    "encoder_input_mode": { "enum": ["external", "discord_opus_rtp", "worker_scene_srt", "worker_scene_frames_srt"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
