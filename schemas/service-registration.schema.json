{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceRegistration",
  "type": "object",
  "required": ["service_id", "service_type", "service_name", "version", "capabilities"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["service_type"],
        "properties": {
          "service_type": { "const": "update_agent" }
        }
      },
      "then": {
        "required": ["transport_mode"],
        "not": {
          "anyOf": [
            { "required": ["host"] },
            { "required": ["port"] },
            { "required": ["public_url"] }
          ]
        }
      },
      "else": {
        "required": ["public_url"],
        "not": { "required": ["transport_mode"] }
      }
    }
  ],
  "properties": {
    "service_id": { "type": "string", "minLength": 1 },
    "service_type": {
      "enum": ["discord_bot", "encoder_recorder", "worker", "observability", "update_agent"]
    },
    "transport_mode": {
      "const": "pull_v2",
      "description": "Required update-agent transport. An update_agent must omit host, port, and public_url. Server-owned execution_host_id and ownership_epoch are never accepted from registration input."
    },
    "service_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "host": { "type": "string" },
    "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "ssl_enabled": { "type": "boolean" },
    "public_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "Control Panelから到達可能なHTTP(S) URL。userinfoは禁止し、private/loopback/link-local宛てはControl Panelの明示allowlistが必要。"
    },
    "version": { "type": "string" },
    "commit": { "type": "string" },
    "build_date": { "type": "string" },
    "capabilities": { "$ref": "encoder-output-relay-capabilities.schema.json" },
    "hostname": { "type": "string" },
    "os": { "type": "string" },
    "arch": { "type": "string" }
  }
}
