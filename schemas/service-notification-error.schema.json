{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/service-notification-error.schema.json",
  "title": "ServiceNotificationError",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retryable"],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
