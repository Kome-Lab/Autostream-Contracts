{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceArtifactReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["service_id", "stream_id", "archive_run_id", "archive_started_at", "artifacts"],
  "dependentRequired": {
    "archive_run_id": ["archive_started_at"],
    "archive_started_at": ["archive_run_id"]
  },
  "properties": {
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "archive_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": { "pattern": "\\.\\." },
      "description": "Stable identifier for one broadcast/archive run of the stream."
    },
    "archive_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Start timestamp of the archive run."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "relative_path", "size_bytes"],
        "properties": {
          "kind": {
            "enum": ["archive", "caption", "transcript", "metadata", "logs"]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^/\\\\]+$"
          },
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^final/[^/\\\\]+/[^/\\\\]+/[^/\\\\]+$",
            "description": "Run-scoped final/{stream_id}/{archive_run_id}/{name} path. The server also verifies embedded identifiers and name equality."
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
