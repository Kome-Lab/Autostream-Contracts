{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/encoder-start-preparation-action.schema.json",
  "title": "EncoderStartPreparationAction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stream_id",
    "start_id",
    "encoder_service_id",
    "job_generation"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "stream_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "start_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "encoder_service_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "job_generation": {
      "type": "integer",
      "minimum": 1
    }
  },
  "x-autostream-path-body-equality": {
    "id": "stream_id",
    "start_id": "start_id"
  }
}
