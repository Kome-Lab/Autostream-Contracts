{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/service-runtime-config.schema.json",
  "title": "ServiceRuntimeConfig",
  "type": "object",
  "required": ["service", "assignments", "profiles"],
  "additionalProperties": false,
  "properties": {
    "service": {
      "description": "Public metadata for the authenticated service. Token binding fields such as token_id are never returned.",
      "$ref": "registered-service.schema.json"
    },
    "assignments": {
      "type": "array",
      "description": "Stream assignments for the authenticated service only. Primary services receive dispatch; standby services are failover candidates and cannot resolve stream-scoped secrets until promoted.",
      "items": {
        "$ref": "service-assignment.schema.json"
      }
    },
    "profiles": {
      "type": "object",
      "description": "Control Panel-managed non-secret runtime profiles filtered to the authenticated service. Raw bot tokens, stream keys, refresh tokens, Drive folder IDs, webhook URLs, SMTP settings, and credential material must be represented only by configured status, fingerprints, or runtime secret reference names.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "profile.schema.json"
        }
      }
    },
    "stream_discord_configs": {
      "type": "array",
      "description": "Resolved per-stream Discord guild/channel settings for the authenticated Discord Bot service only. Values are derived from the stream-selected Discord Bot config plus stream-specific overrides. Raw bot tokens are never included.",
      "items": {
        "type": "object",
        "required": ["stream_id", "assignment_role", "discord_config_id", "guild_id", "voice_channel_id"],
        "additionalProperties": false,
        "properties": {
          "stream_id": { "type": "string" },
          "assignment_role": { "type": "string", "enum": ["primary", "standby"] },
          "discord_config_id": { "type": "string" },
          "guild_id": { "type": "string" },
          "voice_channel_id": { "type": "string" },
          "text_channel_id": { "type": "string" },
          "caption_audio_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "stream_archive_configs": {
      "type": "array",
      "description": "Resolved per-stream archive settings for the authenticated Encoder/Recorder service only. Values include runtime secret reference names and shared-drive flags, but never raw Drive folder IDs, OAuth refresh tokens, client secrets, or credential JSON.",
      "items": {
        "type": "object",
        "required": ["stream_id", "assignment_role", "archive_profile_id", "ready"],
        "additionalProperties": false,
        "properties": {
          "stream_id": { "type": "string" },
          "assignment_role": { "type": "string", "enum": ["primary", "standby"] },
          "archive_profile_id": { "type": "string" },
          "ready": { "type": "boolean" },
          "readiness_code": { "type": "string" },
          "readiness_message": { "type": "string" },
          "archive_config": {
            "type": "object",
            "description": "Non-secret archive dispatch config. Secret material is represented by *_secret_name fields only.",
            "additionalProperties": true,
            "properties": {
              "drive_destination_id": { "type": "string" },
              "archive_profile_id": { "type": "string" },
              "auth_mode": { "type": "string", "enum": ["oauth2", "service_account"] },
              "oauth_account_id": { "type": "string" },
              "oauth_provider_id": { "type": "string" },
              "folder_id_secret_name": { "type": "string" },
              "service_account_credentials_secret_name": { "type": "string" },
              "service_account_json_secret_name": { "type": "string" },
              "base_path": { "type": "string" },
              "shared_drive": { "type": "boolean" },
              "client_id": { "type": "string" },
              "client_secret_secret_name": { "type": "string" },
              "refresh_token_secret_name": { "type": "string" }
            }
          }
        }
      }
    },
    "stream_youtube_configs": {
      "type": "array",
      "description": "Resolved per-stream YouTube output settings for the authenticated Encoder/Recorder service only. Values include RTMPS endpoint metadata and runtime secret reference names, but never raw stream keys, OAuth refresh tokens, or YouTube credential material.",
      "items": {
        "type": "object",
        "required": ["stream_id", "assignment_role", "youtube_output_id", "ready"],
        "additionalProperties": false,
        "properties": {
          "stream_id": { "type": "string" },
          "assignment_role": { "type": "string", "enum": ["primary", "standby"] },
          "youtube_output_id": { "type": "string" },
          "ready": { "type": "boolean" },
          "readiness_code": { "type": "string" },
          "readiness_message": { "type": "string" },
          "youtube_config": {
            "type": "object",
            "description": "Non-secret YouTube dispatch config. Stream key material is represented by stream_key_secret_name only.",
            "additionalProperties": true,
            "properties": {
              "mode": { "type": "string", "enum": ["stream_key", "live_api", "live_api_dry_run"] },
              "output_id": { "type": "string" },
              "rtmp_url": { "type": "string", "pattern": "^rtmps://" },
              "stream_key_secret_name": { "type": "string" },
              "oauth_account_id": { "type": "string" },
              "broadcast_title_template": { "type": "string" },
              "broadcast_description": { "type": "string" },
              "privacy_status": { "type": "string", "enum": ["private", "unlisted", "public"] },
              "latency_preference": { "type": "string", "enum": ["normal", "low", "ultra_low"] },
              "enable_auto_start": { "type": "boolean" },
              "enable_auto_stop": { "type": "boolean" },
              "complete_on_stop": { "type": "boolean" }
            }
          },
          "active_runtime": {
            "type": "object",
            "description": "Current non-secret YouTube runtime state. Runtime stream keys are represented by stream_key_secret_name only.",
            "additionalProperties": true,
            "properties": {
              "mode": { "type": "string" },
              "output_id": { "type": "string" },
              "oauth_account_id": { "type": "string" },
              "broadcast_id": { "type": "string" },
              "live_stream_id": { "type": "string" },
              "rtmp_url": { "type": "string", "pattern": "^rtmps://" },
              "stream_key_secret_name": { "type": "string" },
              "dry_run": { "type": "boolean" },
              "complete_on_stop": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
