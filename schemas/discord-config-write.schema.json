{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/discord-config-write.schema.json",
  "title": "DiscordConfigWriteRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "service_id": { "type": "string" },
    "guild_id": { "type": "string" },
    "voice_channel_id": { "type": "string" },
    "text_channel_id": { "type": "string" },
    "bot_token": {
      "type": "string",
      "writeOnly": true,
      "description": "Write-only Discord Bot token. Never returned by Control API, UI, logs, or audit metadata."
    },
    "caption_enabled": { "type": "boolean" },
    "stt_profile_id": { "type": "string" },
    "reconnect_enabled": { "type": "boolean" },
    "reconnect_max_attempts": { "type": "integer", "minimum": 1 },
    "reconnect_base_delay": { "type": "string" },
    "reconnect_max_delay": { "type": "string" },
    "audio_forward_enabled": { "type": "boolean" }
  }
}
