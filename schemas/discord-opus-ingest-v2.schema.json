{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiscordOpusIngestRequestV2",
  "description": "Generation-fenced Discord Opus ingest contract. Producers must send both job_generation and connection_generation on every packet so a Worker can reject packets from stopped, rearmed, or superseded voice connections.",
  "type": "object",
  "required": ["stream_id", "source", "packets"],
  "additionalProperties": false,
  "properties": {
    "stream_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "packets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["ssrc", "job_generation", "connection_generation", "sequence", "timestamp", "received_at", "opus_base64"],
        "additionalProperties": false,
        "properties": {
          "ssrc": { "type": "integer", "minimum": 0 },
          "user_id": { "type": "string" },
          "job_generation": { "type": "integer", "minimum": 1 },
          "connection_generation": { "type": "integer", "minimum": 1 },
          "sequence": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "timestamp": { "type": "integer", "minimum": 0 },
          "received_at": { "type": "string", "format": "date-time" },
          "opus_base64": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
