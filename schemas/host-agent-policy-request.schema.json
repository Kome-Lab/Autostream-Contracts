{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostAgentPolicyRequest",
  "type": "object",
  "required": ["service_id", "current_revision"],
  "additionalProperties": false,
  "properties": {
    "service_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "current_revision": {
      "type": "integer",
      "minimum": 0
    }
  }
}
