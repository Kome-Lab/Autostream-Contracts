{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/drive-destination.schema.json",
  "type": "object",
  "required": ["id", "name", "auth_mode", "folder_id_configured", "shared_drive", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "auth_mode": { "type": "string", "enum": ["oauth2"] },
    "oauth_account_id": { "type": "string" },
    "folder_id_configured": { "type": "boolean" },
    "folder_id_fingerprint": { "type": "string" },
    "masked_folder_id": { "type": "string" },
    "shared_drive": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
