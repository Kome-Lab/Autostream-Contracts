{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host Self Update",
  "description": "Dedicated durable lifecycle for a Host Agent and Local Executor self-update.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "execution_host_id",
    "agent_service_id",
    "target_version",
    "status",
    "revision",
    "idempotency_key",
    "attempt_generation",
    "expected_ownership_epoch",
    "expected_source_policy_revision",
    "expected_projection_revision",
    "expected_local_executor_policy_revision",
    "expected_local_executor_policy_sha256",
    "previous_agent_version",
    "previous_executor_version",
    "previous_agent_protocol_version",
    "previous_executor_protocol_version",
    "previous_mutation_protocol_version",
    "previous_recovery_protocol_version",
    "release",
    "issued_at",
    "observation_state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "execution_host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
    },
    "agent_service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "target_version": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128,
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "status": {
      "enum": [
        "queued",
        "staging",
        "activating",
        "verifying",
        "rolling_back",
        "cancel_requested",
        "succeeded",
        "rolled_back",
        "failed",
        "canceled"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "retry_of_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "attempt_generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "expected_ownership_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "expected_source_policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_projection_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_local_executor_policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_local_executor_policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "previous_agent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "previous_executor_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "previous_agent_protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "previous_executor_protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "previous_mutation_protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "previous_recovery_protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "release": {
      "$ref": "host-self-update-release.schema.json"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_state": {
      "enum": ["known", "stalled", "unknown"]
    },
    "reported_phase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "last_heartbeat_at": {
      "type": "string",
      "format": "date-time"
    },
    "stalled_since": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
