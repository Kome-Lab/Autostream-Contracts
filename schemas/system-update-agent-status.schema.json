{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System Update Agent Status",
  "description": "Updater heartbeat and capability projection. Payloads declaring protocol_version 2 are strict pull_v2 records. Payloads without protocol_version are temporary legacy compatibility owned by V2-COMPAT-EOL-CONTRACTS-001 and removed in Execution Bundle 8.",
  "x-autostream-contract-major": 2,
  "x-autostream-v2-transition-compatibility": {
    "owner": "V2-COMPAT-EOL-CONTRACTS-001",
    "removal_wave": "Execution Bundle 8",
    "final_state": "absent"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["updater_id", "name", "status", "online", "version"],
  "allOf": [
    {
      "if": { "required": ["protocol_version"] },
      "then": {
        "required": [
          "protocol_version", "updater_id", "host_id", "service_id", "name",
          "transport_mode", "authentication", "status", "online", "version", "heartbeat_sequence",
          "capabilities", "desired_revision", "applied_revision", "fence"
        ],
        "properties": {
          "transport_mode": { "const": "pull_v2" },
          "desired_revision": { "minimum": 1 },
          "applied_revision": { "minimum": 0 },
          "fence": { "minimum": 1 }
        },
        "not": {
          "anyOf": [
            { "required": ["ssh_client_public_keys"] },
            { "required": ["ssh_client_key_fingerprints"] }
          ]
        }
      }
    }
  ],
  "properties": {
    "protocol_version": { "const": 2 },
    "updater_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "authentication": { "const": "assignment_bound_rotating_service_identity" },
    "name": { "type": "string", "minLength": 1, "maxLength": 191 },
    "transport_mode": { "enum": ["ssh_v1", "pull_v2"] },
    "execution_host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
    },
    "ownership_epoch": { "type": "integer", "minimum": 0 },
    "status": { "type": "string", "minLength": 1, "maxLength": 64 },
    "online": { "type": "boolean" },
    "version": { "type": "string", "maxLength": 128 },
    "last_heartbeat_at": { "type": "string", "format": "date-time" },
    "heartbeat_sequence": { "type": "integer", "minimum": 0 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "host.systemd", "host.docker", "host.update", "host.bootstrap",
          "host.port", "host.self_update"
        ]
      }
    },
    "desired_revision": { "type": "integer", "minimum": 0 },
    "applied_revision": { "type": "integer", "minimum": 0 },
    "fence": { "type": "integer", "minimum": 1 },
    "policy_status": { "enum": ["applied", "pending", "failed"] },
    "policy_error_code": {
      "enum": [
        "policy_fetch_failed",
        "policy_invalid",
        "ssh_identity_failed",
        "ssh_connectivity_failed",
        "policy_snapshot_failed",
        "coordinator_start_failed",
        "active_job_pending"
      ]
    },
    "ssh_client_public_keys": {
      "type": "object",
      "propertyNames": {
        "maxLength": 191,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43}$"
      }
    },
    "ssh_client_key_fingerprints": {
      "type": "object",
      "propertyNames": {
        "maxLength": 191,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 50,
        "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
      }
    },
    "bootstrap_encryption_public_key": {
      "type": "string",
      "maxLength": 87,
      "pattern": "^B[A-Za-z0-9_-]{86}$"
    },
    "bootstrap_encryption_key_fingerprint": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
    }
  }
}
