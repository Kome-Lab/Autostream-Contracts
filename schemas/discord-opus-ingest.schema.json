{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiscordOpusIngestRequest",
  "type": "object",
  "required": ["stream_id", "source", "packets"],
  "additionalProperties": false,
  "properties": {
    "stream_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "packets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["ssrc", "sequence", "timestamp", "received_at", "opus_base64"],
        "additionalProperties": false,
        "properties": {
          "ssrc": { "type": "integer", "minimum": 0 },
          "user_id": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "timestamp": { "type": "integer", "minimum": 0 },
          "received_at": { "type": "string", "format": "date-time" },
          "opus_base64": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
