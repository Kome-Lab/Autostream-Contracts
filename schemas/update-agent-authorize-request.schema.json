{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Update Agent Mutation Authorization Request",
  "description": "Root-helper authorization checked immediately before creating a checkpoint or mutating a managed target. Authorization is valid only for the current nonterminal installing or reconciling job and is never replayable after a terminal state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_id",
    "lease_token",
    "lease_generation",
    "target_id",
    "target_version",
    "deployment_mode"
  ],
  "properties": {
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "lease_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$",
      "writeOnly": true
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 1
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[^\u0000-\u001F\u007F]+$",
      "description": "Optional execution-host identity. It is required for central multi-host operation; omission retains legacy per-host updater behavior."
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "target_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\u0000-\u001F\u007F]+$"
    },
    "deployment_mode": {
      "enum": ["systemd", "docker"]
    }
  }
}
