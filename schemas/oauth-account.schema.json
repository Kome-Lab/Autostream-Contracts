{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/oauth-account.schema.json",
  "type": "object",
  "required": ["id", "provider_id", "provider_type", "account_label", "scopes", "refresh_token_configured", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string" },
    "provider_id": { "type": "string" },
    "provider_type": { "type": "string", "enum": ["google", "github", "discord"] },
    "account_label": { "type": "string" },
    "subject": { "type": "string" },
    "email": { "type": "string" },
    "scopes": { "type": "array", "items": { "type": "string" } },
    "refresh_token_configured": { "type": "boolean" },
    "token_fingerprint": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
