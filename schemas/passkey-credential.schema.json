{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/passkey-credential.schema.json",
  "title": "PasskeyCredential",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "user_id", "name", "credential_id_hash", "sign_count"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "credential_id_hash": {
      "type": "string",
      "minLength": 64,
      "description": "Hash of the WebAuthn credential ID. Raw credential ID is never returned."
    },
    "sign_count": { "type": "integer", "minimum": 0 },
    "transports": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "aaguid": { "type": "string" },
    "backup_eligible": { "type": "boolean" },
    "backed_up": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_used_at": { "type": "string", "format": "date-time" }
  }
}
