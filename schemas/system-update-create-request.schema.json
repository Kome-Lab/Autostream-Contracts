{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System Update Create Request",
  "description": "Control Panel orchestration intent. protocol_version 2 carries only typed revision-fenced intent and never accepts host execution details.",
  "x-autostream-contract-major": 2,
  "x-autostream-v2-transition-compatibility": {
    "owner": "V2-COMPAT-EOL-CONTRACTS-001",
    "removal_wave": "Execution Bundle 8",
    "final_state": "absent"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["target_id", "idempotency_key"],
  "allOf": [
    {
      "if": {
        "required": ["operation"],
        "properties": {
          "operation": { "const": "port_reconfigure" }
        }
      },
      "then": {
        "required": ["operation", "expected_endpoint_revision"],
        "not": { "required": ["strategy"] },
        "oneOf": [
          {
            "required": ["new_port"],
            "not": {
              "anyOf": [
                { "required": ["new_advertised_port"] },
                { "required": ["new_published_port"] },
                { "required": ["new_container_port"] }
              ]
            }
          },
          {
            "required": ["new_advertised_port", "new_published_port", "new_container_port"],
            "not": { "required": ["new_port"] }
          }
        ]
      },
      "else": {
        "required": ["strategy"],
        "not": {
          "anyOf": [
            { "required": ["new_port"] },
            { "required": ["new_advertised_port"] },
            { "required": ["new_published_port"] },
            { "required": ["new_container_port"] },
            { "required": ["expected_endpoint_revision"] }
          ]
        }
      }
    },
    {
      "if": { "required": ["protocol_version"] },
      "then": {
        "required": ["protocol_version", "desired_revision", "fence", "required_capability"],
        "oneOf": [
          {
            "required": ["operation"],
            "properties": {
              "operation": { "const": "port_reconfigure" },
              "required_capability": { "const": "host.port" }
            }
          },
          {
            "required": ["operation"],
            "properties": {
              "operation": { "const": "software_update" },
              "required_capability": { "const": "host.update" }
            }
          },
          {
            "not": { "required": ["operation"] },
            "properties": {
              "required_capability": { "const": "host.update" }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "protocol_version": { "const": 2 },
    "operation": {
      "enum": ["software_update", "port_reconfigure"],
      "default": "software_update"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "strategy": { "enum": ["when_idle", "maintenance"] },
    "new_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "new_advertised_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "new_published_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "new_container_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "expected_endpoint_revision": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "desired_revision": { "type": "integer", "minimum": 1 },
    "fence": { "type": "integer", "minimum": 1 },
    "required_capability": {
      "enum": [
        "host.systemd", "host.docker", "host.update", "host.bootstrap",
        "host.port", "host.self_update"
      ]
    }
  }
}
