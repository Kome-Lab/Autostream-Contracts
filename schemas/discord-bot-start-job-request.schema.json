{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiscordBotStartJobRequest",
  "description": "AutoStream Discord Bot start envelope. Control Panel may send schema_version=2 only when the assigned Bot's current capability map advertises discord_resolved_target_v2 as boolean true; a version string alone, an absent capability, false, or an unknown value is not support evidence. schema_version=2 delivers target IDs only as one server-resolved snapshot and rejects legacy flat target fields. Otherwise Control Panel sends the legacy flat target payload and omits every v2-only field. Payloads without schema_version retain a narrowly scoped compatibility branch in which legacy flat target fields remain accepted until Execution Bundle 8; the Bot never reads preset resources.",
  "type": "object",
  "required": ["stream_id", "job_generation"],
  "additionalProperties": false,
  "x-autostream-contract-major": 2,
  "x-autostream-v2-transition-compatibility": {
    "owner": "V2-COMPAT-EOL-CONTRACTS-001",
    "removal_wave": "Execution Bundle 8",
    "final_state": "absent"
  },
  "x-autostream-visual-contract-definitions": [
    "themePreference",
    "themePreferenceWrite",
    "mediaAssetDescriptor",
    "sceneAppearance",
    "discordTargetSelection",
    "discordTargetStoredSnapshot",
    "discordTargetSnapshot",
    "videoCoverStartSnapshot",
    "encoderVideoCoverApplyRequest",
    "encoderVideoCoverApplyResponse",
    "videoCoverAppliedWitness",
    "videoCoverRuntimeState",
    "videoCoverStateRequest",
    "visualPipelineInvariant"
  ],
  "x-autostream-visual-contract-catalog": {
    "theme_preference": { "$ref": "#/$defs/themePreference" },
    "theme_preference_write": { "$ref": "#/$defs/themePreferenceWrite" },
    "scene_appearance": { "$ref": "#/$defs/sceneAppearance" },
    "discord_target_selection": { "$ref": "#/$defs/discordTargetSelection" },
    "discord_target_stored_snapshot": { "$ref": "#/$defs/discordTargetStoredSnapshot" },
    "video_cover_start_snapshot": { "$ref": "#/$defs/videoCoverStartSnapshot" },
    "encoder_video_cover_apply_request": { "$ref": "#/$defs/encoderVideoCoverApplyRequest" },
    "encoder_video_cover_apply_response": { "$ref": "#/$defs/encoderVideoCoverApplyResponse" },
    "video_cover_state_request": { "$ref": "#/$defs/videoCoverStateRequest" },
    "video_cover_runtime_state": { "$ref": "#/$defs/videoCoverRuntimeState" }
  },
  "$defs": {
    "readiness": {
      "enum": ["ready", "not_ready", "unknown"]
    },
    "safeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "invalid_theme_id",
            "media_asset_format_unsupported",
            "media_asset_too_large",
            "media_asset_decode_failed",
            "media_asset_aspect_ratio_invalid",
            "media_asset_variant_processing",
            "media_asset_variant_failed",
            "media_asset_unauthorized",
            "media_asset_not_found",
            "media_asset_hash_mismatch",
            "media_asset_dimension_mismatch",
            "media_asset_timeout",
            "discord_target_invalid",
            "preset_not_found",
            "preset_revision_conflict",
            "stale_job_generation",
            "stale_cover_generation",
            "stale_cover_revision",
            "idempotency_conflict",
            "cover_apply_ambiguous",
            "cover_graph_unavailable",
            "revision_payload_conflict",
            "capability_required"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "themePreference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme_id", "color_mode", "revision", "readiness"],
      "properties": {
        "theme_id": {
          "enum": [
            "autostream",
            "slate",
            "ocean",
            "cyan",
            "indigo",
            "violet",
            "magenta",
            "rose",
            "crimson",
            "amber",
            "emerald",
            "monochrome"
          ]
        },
        "color_mode": {
          "enum": ["system", "light", "dark"]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "error": {
          "$ref": "#/$defs/safeError"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["readiness"],
            "properties": { "readiness": { "enum": ["not_ready", "unknown"] } }
          },
          "then": { "required": ["error"] },
          "else": { "not": { "required": ["error"] } }
        }
      ]
    },
    "themePreferenceWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme_id", "color_mode", "expected_revision"],
      "properties": {
        "theme_id": {
          "enum": ["autostream", "slate", "ocean", "cyan", "indigo", "violet", "magenta", "rose", "crimson", "amber", "emerald", "monochrome"]
        },
        "color_mode": { "enum": ["system", "light", "dark"] },
        "expected_revision": { "type": "integer", "minimum": 0 }
      },
      "description": "Authenticated self-update CAS input. Revision mismatch is revision_conflict; admin reset uses the existing users.update authority."
    },
    "mediaAssetDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "variant_id",
        "usage",
        "media_type",
        "width",
        "height",
        "byte_size",
        "pixel_count",
        "animated",
        "sha256",
        "revision",
        "readiness"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "variant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "usage": { "enum": ["scene_background", "video_cover"] },
        "media_type": {
          "enum": ["image/png", "image/jpeg", "image/webp"]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "pixel_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40000000,
          "description": "The producer must verify this equals decoded width multiplied by height before declaring readiness."
        },
        "animated": {
          "const": false
        },
        "aspect_ratio_error_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "opaque": { "type": "boolean" },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Public integrity digest only; never an authentication credential."
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Immutable processed-variant revision. It is copied from media_asset_variants.processor_revision and never changes for an existing variant identity.",
          "x-autostream-source": "media_asset_variants.processor_revision",
          "x-autostream-immutability": "processed_variant"
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "error": {
          "$ref": "#/$defs/safeError"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["readiness"],
            "properties": { "readiness": { "enum": ["not_ready", "unknown"] } }
          },
          "then": { "required": ["error"] },
          "else": { "not": { "required": ["error"] } }
        },
        {
          "if": {
            "required": ["usage"],
            "properties": { "usage": { "const": "video_cover" } }
          },
          "then": {
            "required": ["aspect_ratio_error_ppm", "opaque"],
            "properties": { "opaque": { "const": true } }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["aspect_ratio_error_ppm"] },
                { "required": ["opaque"] }
              ]
            }
          }
        }
      ],
      "description": "Static PNG, JPEG, or WebP metadata only. SVG, GIF, animation, filesystem paths, URLs, and Base64 payloads are not representable."
    },
    "sceneAppearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "revision",
        "capability",
        "readiness",
        "background_mode",
        "header_title_mode"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Control Panel-owned stream visual runtime generation. It advances for every stream start and is the same epoch value as Video Cover job_generation for that start; it is not the Worker-issued job generation.",
          "x-autostream-owner": "control_panel",
          "x-autostream-epoch": "video_cover_job_generation",
          "x-autostream-advance": "every_stream_start"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Exact stream_visual_settings.revision captured in this immutable start snapshot.",
          "x-autostream-source": "stream_visual_settings.revision"
        },
        "capability": {
          "const": "scene_appearance_v1"
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "background_mode": {
          "enum": ["default", "image"]
        },
        "background": {
          "$ref": "#/$defs/mediaAssetDescriptor",
          "properties": { "usage": { "const": "scene_background" } }
        },
        "header_title_mode": {
          "enum": ["default", "custom"]
        },
        "custom_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\r\\n]+$"
        },
        "error": {
          "$ref": "#/$defs/safeError"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["background_mode"],
            "properties": {
              "background_mode": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": ["background"]
          },
          "else": {
            "not": {
              "required": ["background"]
            }
          }
        },
        {
          "if": {
            "required": ["header_title_mode"],
            "properties": {
              "header_title_mode": {
                "const": "custom"
              }
            }
          },
          "then": {
            "required": ["custom_title"]
          },
          "else": {
            "not": {
              "required": ["custom_title"]
            }
          }
        },
        {
          "if": {
            "required": ["readiness"],
            "properties": { "readiness": { "enum": ["not_ready", "unknown"] } }
          },
          "then": { "required": ["error"] },
          "else": { "not": { "required": ["error"] } }
        },
        {
          "if": {
            "required": ["readiness", "background_mode"],
            "properties": {
              "readiness": { "const": "ready" },
              "background_mode": { "const": "image" }
            }
          },
          "then": {
            "properties": {
              "background": {
                "required": ["readiness"],
                "properties": { "readiness": { "const": "ready" } }
              }
            }
          }
        },
        {
          "if": {
            "required": ["background"],
            "properties": {
              "background": {
                "required": ["readiness"],
                "properties": { "readiness": { "enum": ["not_ready", "unknown"] } }
              }
            }
          },
          "then": {
            "properties": { "readiness": { "enum": ["not_ready", "unknown"] } },
            "required": ["error"]
          }
        }
      ]
    },
    "resolvedDiscordTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guild_id", "text_channel_id", "voice_channel_id"],
      "properties": {
        "guild_id": {
          "type": "string",
          "pattern": "^[0-9]{1,32}$"
        },
        "text_channel_id": {
          "type": "string",
          "pattern": "^[0-9]{1,32}$"
        },
        "voice_channel_id": {
          "type": "string",
          "pattern": "^[0-9]{1,32}$"
        }
      }
    },
    "discordTargetSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["inherit", "preset", "manual"] },
        "preset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "manual_target": { "$ref": "#/$defs/resolvedDiscordTarget" }
      },
      "allOf": [
        {
          "if": {
            "required": ["mode"],
            "properties": { "mode": { "const": "preset" } }
          },
          "then": { "required": ["preset_id"] },
          "else": { "not": { "required": ["preset_id"] } }
        },
        {
          "if": {
            "required": ["mode"],
            "properties": { "mode": { "const": "manual" } }
          },
          "then": { "required": ["manual_target"] },
          "else": { "not": { "required": ["manual_target"] } }
        }
      ]
    },
    "discordTargetStoredSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "revision", "resolved"],
      "properties": {
        "mode": { "enum": ["inherit", "preset", "manual"] },
        "preset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "preset_revision": { "type": "integer", "minimum": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "resolved": { "$ref": "#/$defs/resolvedDiscordTarget" }
      },
      "allOf": [
        {
          "if": {
            "required": ["mode"],
            "properties": { "mode": { "const": "preset" } }
          },
          "then": { "required": ["preset_id", "preset_revision"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["preset_id"] },
                { "required": ["preset_revision"] }
              ]
            }
          }
        }
      ],
      "description": "Control Panel-owned immutable stream snapshot. Preset edits do not mutate this record without an explicit revisioned action."
    },
    "discordTargetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "resolved"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "resolved": { "$ref": "#/$defs/resolvedDiscordTarget" }
      },
      "description": "Bot-facing resolved snapshot. Preset IDs, inheritance metadata, and manual selection inputs are deliberately absent."
    },
    "visualPipelineInvariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layers",
        "watermark_topmost",
        "cover_watermark_independent",
        "output_parity",
        "audio_continuity"
      ],
      "properties": {
        "layers": {
          "type": "array",
          "prefixItems": [
            {
              "const": "base_or_worker_scene"
            },
            {
              "const": "video_cover"
            },
            {
              "const": "watermark"
            },
            {
              "const": "video_encode"
            },
            {
              "const": "tee_live_archive_preview"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "watermark_topmost": {
          "const": true
        },
        "cover_watermark_independent": {
          "const": true
        },
        "output_parity": {
          "type": "array",
          "prefixItems": [
            {
              "const": "live"
            },
            {
              "const": "archive"
            },
            {
              "const": "preview"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "audio_continuity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "process_restart",
            "audio_encoder_restart",
            "audio_mux_restart",
            "graph_rebuild",
            "reconnect",
            "sequence_loss",
            "timestamp_discontinuity",
            "intentional_mute_insertion"
          ],
          "properties": {
            "process_restart": {
              "const": 0
            },
            "audio_encoder_restart": {
              "const": 0
            },
            "audio_mux_restart": {
              "const": 0
            },
            "graph_rebuild": {
              "const": 0
            },
            "reconnect": {
              "const": 0
            },
            "sequence_loss": {
              "const": 0
            },
            "timestamp_discontinuity": {
              "const": 0
            },
            "intentional_mute_insertion": {
              "const": 0
            }
          }
        }
      }
    },
    "desiredCoverState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "revision", "source"],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "source": { "enum": ["none", "preset", "upload"] },
        "variant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["active"],
            "properties": { "active": { "const": true } }
          },
          "then": {
            "required": ["variant_id"],
            "properties": { "source": { "enum": ["preset", "upload"] } }
          },
          "else": {
            "properties": { "source": { "const": "none" } },
            "not": { "required": ["variant_id"] }
          }
        }
      ]
    },
    "appliedCoverState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["known", "unknown"]
        },
        "active": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["state"],
            "properties": {
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "required": ["active", "revision"]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["active"]
                },
                {
                  "required": ["revision"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["state", "active"],
            "properties": {
              "state": { "const": "known" },
              "active": { "const": true }
            }
          },
          "then": { "required": ["variant_id"] },
          "else": { "not": { "required": ["variant_id"] } }
        }
      ]
    },
    "knownAppliedCoverState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "active", "revision"],
      "properties": {
        "state": { "const": "known" },
        "active": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 1 },
        "variant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["active"],
            "properties": { "active": { "const": true } }
          },
          "then": { "required": ["variant_id"] },
          "else": { "not": { "required": ["variant_id"] } }
        }
      ]
    },
    "layerState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "revision"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["enabled"],
            "properties": { "enabled": { "const": true } }
          },
          "then": { "required": ["variant_id"] },
          "else": { "not": { "required": ["variant_id"] } }
        }
      ]
    },
    "videoCoverStartSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_generation", "revision", "active", "idempotency_key"],
      "properties": {
        "job_generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Control Panel-owned stream visual start epoch shared with Scene Appearance generation.",
          "x-autostream-owner": "control_panel",
          "x-autostream-epoch": "video_cover_job_generation"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Desired Video Cover revision captured for this start."
        },
        "active": { "type": "boolean" },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x20\\x7F\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF](?:[^\\x00-\\x1F\\x7F]*[^\\x00-\\x20\\x7F\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF])?$"
        },
        "cover_asset": {
          "$ref": "#/$defs/mediaAssetDescriptor",
          "properties": {
            "usage": { "const": "video_cover" },
            "readiness": { "const": "ready" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["active"],
            "properties": { "active": { "const": true } }
          },
          "then": { "required": ["cover_asset"] },
          "else": { "not": { "required": ["cover_asset"] } }
        }
      ],
      "description": "Desired Video Cover start snapshot. New Control Panel producers send it for both active and inactive desired state so Encoder binds job_generation and revision before GET/reconcile. active=true requires cover_asset; active=false forbids cover_asset. Whole-field omission remains only for legacy callers during compatibility."
    },
    "encoderVideoCoverApplyRequest": {
      "type": "object",
      "additionalProperties": false,
      "x-autostream-path-body-equality": {
        "path_parameter": "id",
        "body_property": "stream_id",
        "comparison": "exact",
        "validator": "contracts.ValidateEncoderVideoCoverApplyRequest"
      },
      "required": [
        "stream_id",
        "job_generation",
        "expected_generation",
        "revision",
        "active",
        "idempotency_key"
      ],
      "properties": {
        "stream_id": { "type": "string", "minLength": 1 },
        "job_generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Control Panel-owned stream visual start epoch."
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 1,
          "description": "CAS fence for the Encoder-owned graph instance generation currently observed by Control Panel.",
          "x-autostream-owner": "encoder_recorder",
          "x-autostream-fence": "exact_current_generation"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Desired Video Cover revision."
        },
        "active": { "type": "boolean" },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x20\\x7F\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF](?:[^\\x00-\\x1F\\x7F]*[^\\x00-\\x20\\x7F\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF])?$"
        },
        "cover_asset": {
          "$ref": "#/$defs/mediaAssetDescriptor",
          "properties": {
            "usage": { "const": "video_cover" },
            "readiness": { "const": "ready" }
          }
        },
        "hide_confirmed": {
          "const": true,
          "description": "Required for hide. An ambiguous hide outcome is reconciled by GET and is never automatically resent."
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["active"],
            "properties": { "active": { "const": true } }
          },
          "then": {
            "required": ["cover_asset"],
            "not": { "required": ["hide_confirmed"] }
          },
          "else": {
            "required": ["hide_confirmed"],
            "not": { "required": ["cover_asset"] }
          }
        }
      ],
      "description": "Strict Control Panel to Encoder Video Cover CAS. It can mutate only the Cover layer; Watermark fields are intentionally not representable. OpenAPI path id and body stream_id equality is enforced by the named behavioral validator because JSON Schema cannot express that relation."
    },
    "videoCoverAppliedWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_applied",
        "generation",
        "revision",
        "active",
        "cover",
        "watermark",
        "pipeline"
      ],
      "properties": {
        "graph_applied": {
          "const": true,
          "description": "True only after the Encoder graph has applied the Cover state. Acceptance or asset validation alone cannot produce this witness."
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Encoder-owned graph instance generation that applied this state."
        },
        "revision": { "type": "integer", "minimum": 1 },
        "active": { "type": "boolean" },
        "cover": { "$ref": "#/$defs/layerState" },
        "watermark": {
          "$ref": "#/$defs/layerState",
          "description": "Independently observed Watermark layer; a Cover mutation cannot change it."
        },
        "pipeline": { "$ref": "#/$defs/visualPipelineInvariant" }
      },
      "allOf": [
        {
          "if": {
            "required": ["active"],
            "properties": { "active": { "const": true } }
          },
          "then": {
            "properties": {
              "cover": {
                "required": ["enabled", "variant_id"],
                "properties": { "enabled": { "const": true } }
              }
            }
          },
          "else": {
            "properties": {
              "cover": {
                "required": ["enabled"],
                "properties": { "enabled": { "const": false } },
                "not": { "required": ["variant_id"] }
              }
            }
          }
        }
      ]
    },
    "encoderVideoCoverApplyResponse": {
      "type": "object",
      "additionalProperties": false,
      "x-autostream-behavioral-validator": "contracts.ValidateEncoderVideoCoverApplyResponse",
      "x-autostream-applied-linkage": [
        "stream_id=actual.stream_id",
        "job_generation=actual.job_generation",
        "actual_generation=actual.generation=actual.applied_witness.generation",
        "requested_revision=actual.desired.revision=actual.applied.revision=actual.cover.revision=actual.applied_witness.revision=actual.applied_witness.cover.revision",
        "actual.desired.active=actual.applied.active=actual.cover.enabled=actual.applied_witness.active=actual.applied_witness.cover.enabled",
        "actual.cover=actual.applied_witness.cover",
        "actual.watermark=actual.applied_witness.watermark",
        "actual.pipeline=actual.applied_witness.pipeline"
      ],
      "required": [
        "stream_id",
        "job_generation",
        "requested_revision",
        "actual_generation",
        "accepted",
        "rejected",
        "applied",
        "outcome",
        "actual"
      ],
      "properties": {
        "stream_id": { "type": "string", "minLength": 1 },
        "job_generation": { "type": "integer", "minimum": 1 },
        "requested_revision": { "type": "integer", "minimum": 1 },
        "actual_generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Encoder-owned graph instance generation observed when producing this response.",
          "x-autostream-owner": "encoder_recorder",
          "x-autostream-scope": "job_generation"
        },
        "accepted": { "type": "boolean" },
        "rejected": { "type": "boolean" },
        "applied": { "type": "boolean" },
        "outcome": { "enum": ["applied", "rejected", "ambiguous"] },
        "actual": { "$ref": "#/$defs/videoCoverRuntimeState" },
        "error": { "$ref": "#/$defs/safeError" }
      },
      "allOf": [
        {
          "if": {
            "required": ["outcome"],
            "properties": { "outcome": { "const": "applied" } }
          },
          "then": {
            "properties": {
              "accepted": { "const": true },
              "rejected": { "const": false },
              "applied": { "const": true },
              "actual": {
                "required": ["readiness", "applied_witness"],
                "properties": { "readiness": { "const": "ready" } }
              }
            },
            "not": { "required": ["error"] }
          }
        },
        {
          "if": {
            "required": ["outcome"],
            "properties": { "outcome": { "const": "rejected" } }
          },
          "then": {
            "required": ["error"],
            "properties": {
              "accepted": { "const": false },
              "rejected": { "const": true },
              "applied": { "const": false }
            }
          }
        },
        {
          "if": {
            "required": ["outcome"],
            "properties": { "outcome": { "const": "ambiguous" } }
          },
          "then": {
            "required": ["error"],
            "properties": {
              "accepted": { "const": true },
              "rejected": { "const": false },
              "applied": { "const": false },
              "actual": {
                "required": ["readiness", "applied"],
                "properties": {
                  "readiness": { "const": "unknown" },
                  "applied": {
                    "required": ["state"],
                    "properties": { "state": { "const": "unknown" } }
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Strict Encoder apply result. Applied=true is impossible without an actual runtime state carrying a graph-applied witness. Cross-field equality is enforced by the named behavioral validator because JSON Schema cannot express value equality between object locations."
    },
    "videoCoverStateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "expected_job_generation", "expected_revision", "idempotency_key"],
      "properties": {
        "active": { "type": "boolean" },
        "expected_job_generation": { "type": "integer", "minimum": 1 },
        "expected_revision": { "type": "integer", "minimum": 1 },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x20\\x7F\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF](?:[^\\x00-\\x1F\\x7F]*[^\\x00-\\x20\\x7F\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF])?$"
        },
        "hide_confirmed": { "const": true }
      },
      "allOf": [
        {
          "if": {
            "required": ["active"],
            "properties": { "active": { "const": false } }
          },
          "then": { "required": ["hide_confirmed"] },
          "else": { "not": { "required": ["hide_confirmed"] } }
        }
      ],
      "description": "Revisioned public Cover state CAS. Ambiguous results are reconciled through state read and never automatically resent."
    },
    "videoCoverRuntimeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "job_generation",
        "generation",
        "capability",
        "readiness",
        "desired",
        "applied",
        "cover",
        "watermark",
        "pipeline",
        "no_automatic_resend"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "job_generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Control Panel-owned stream visual start epoch shared with Scene Appearance generation.",
          "x-autostream-owner": "control_panel",
          "x-autostream-epoch": "video_cover_job_generation"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Encoder-owned graph instance generation. It increases monotonically within one job_generation whenever a new graph instance becomes authoritative.",
          "x-autostream-owner": "encoder_recorder",
          "x-autostream-scope": "job_generation",
          "x-autostream-monotonic": true
        },
        "capability": {
          "const": "live_video_cover_v1"
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "desired": {
          "$ref": "#/$defs/desiredCoverState"
        },
        "applied": {
          "$ref": "#/$defs/appliedCoverState"
        },
        "cover": {
          "$ref": "#/$defs/layerState",
          "description": "Current Cover imagefeed layer state, independent from Watermark."
        },
        "cover_asset": {
          "$ref": "#/$defs/mediaAssetDescriptor",
          "properties": { "usage": { "const": "video_cover" } }
        },
        "watermark": {
          "$ref": "#/$defs/layerState",
          "description": "Current Watermark imagefeed layer state, independent from Cover."
        },
        "pipeline": {
          "$ref": "#/$defs/visualPipelineInvariant"
        },
        "applied_witness": {
          "$ref": "#/$defs/videoCoverAppliedWitness"
        },
        "no_automatic_resend": {
          "const": true,
          "description": "Unknown or ambiguous applied state requires an explicit operator resend with a new revision."
        },
        "last_good_applied": {
          "$ref": "#/$defs/knownAppliedCoverState"
        },
        "error": {
          "$ref": "#/$defs/safeError"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["readiness"],
            "properties": { "readiness": { "enum": ["not_ready", "unknown"] } }
          },
          "then": { "required": ["error"] },
          "else": { "not": { "required": ["error"] } }
        },
        {
          "if": {
            "required": ["applied"],
            "properties": {
              "applied": {
                "required": ["state"],
                "properties": { "state": { "const": "unknown" } }
              }
            }
          },
          "then": {
            "required": ["last_good_applied", "error"],
            "properties": { "readiness": { "enum": ["not_ready", "unknown"] } },
            "not": { "required": ["applied_witness"] }
          }
        },
        {
          "if": {
            "required": ["applied"],
            "properties": {
              "applied": {
                "required": ["state"],
                "properties": { "state": { "const": "known" } }
              }
            }
          },
          "then": { "required": ["applied_witness"] }
        },
        {
          "if": {
            "required": ["readiness"],
            "properties": { "readiness": { "const": "ready" } }
          },
          "then": {
            "properties": {
              "applied": {
                "required": ["state"],
                "properties": { "state": { "const": "known" } }
              }
            }
          }
        },
        {
          "if": {
            "required": ["desired"],
            "properties": {
              "desired": {
                "required": ["active"],
                "properties": { "active": { "const": true } }
              }
            }
          },
          "then": { "required": ["cover_asset"] },
          "else": { "not": { "required": ["cover_asset"] } }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "required": ["schema_version"] },
      "then": {
        "required": ["schema_version", "discord_target"],
        "not": {
          "anyOf": [
            { "required": ["guild_id"] },
            { "required": ["text_channel_id"] },
            { "required": ["voice_channel_id"] }
          ]
        }
      },
      "else": {
        "required": ["guild_id", "voice_channel_id"],
        "not": { "required": ["discord_target"] }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "job_generation": {
      "type": "integer",
      "minimum": 1,
      "description": "Worker-issued positive uint64 generation fence for this exact stream job. Control Panel must pass it through unchanged, and consumers must reject missing, zero, or values outside the uint64 range before starting the job."
    },
    "discord_target": {
      "$ref": "#/$defs/discordTargetSnapshot"
    },
    "guild_id": {
      "type": "string",
      "minLength": 1,
      "description": "Temporary legacy adapter field removed in Execution Bundle 8. v2 payloads cannot include it."
    },
    "text_channel_id": {
      "type": "string",
      "minLength": 1,
      "description": "Temporary legacy adapter field removed in Execution Bundle 8. v2 payloads cannot include it."
    },
    "voice_channel_id": {
      "type": "string",
      "minLength": 1,
      "description": "Temporary legacy adapter field removed in Execution Bundle 8. v2 payloads cannot include it."
    },
    "encoder_audio_url": {
      "type": "string",
      "format": "uri",
      "description": "Encoder/Recorder audio ingest endpoint. Treat as runtime-only and do not expose it in public status or logs."
    },
    "caption_audio_url": {
      "type": "string",
      "format": "uri",
      "description": "Optional caption/STT audio ingest endpoint. Treat as runtime-only and do not expose it in public status or logs."
    },
    "caption_audio_token": {
      "type": "string",
      "minLength": 1,
      "writeOnly": true,
      "description": "Short-lived stream-scoped token authorizing Discord Opus ingest at the selected Worker. It must never be returned by status endpoints, logs, audit metadata, or frontend API responses."
    },
    "caption_audio_flush_ms": {
      "type": "integer",
      "minimum": 10,
      "maximum": 1000,
      "description": "Optional start snapshot of caption_profile_config.caption_audio_flush_ms. Bounds are owned by the canonical Caption Profile contract."
    },
    "caption_audio_max_batch_packets": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Optional start snapshot of caption_profile_config.caption_audio_max_batch_packets. Bounds are owned by the canonical Caption Profile contract."
    },
    "unresolved_ssrc_buffer_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000,
      "description": "Optional start snapshot of caption_profile_config.unresolved_ssrc_buffer_ms. Bounds are owned by the canonical Caption Profile contract."
    },
    "stream_ingest_token": {
      "type": "string",
      "minLength": 1,
      "writeOnly": true,
      "description": "Short-lived stream-scoped ingest token issued by Control Panel. It must never be returned by status endpoints, logs, audit metadata, or frontend API responses."
    },
    "worker_events_url": {
      "type": "string",
      "format": "uri",
      "description": "Worker event endpoint selected by this stream's Worker assignment. Treat as runtime-only and do not expose it in public status or logs."
    },
    "worker_events_token": {
      "type": "string",
      "minLength": 1,
      "writeOnly": true,
      "description": "Short-lived stream-scoped token for Discord Bot to publish participant, active speaker, and chat events to the selected Worker. It must never be returned by status endpoints, logs, audit metadata, or frontend API responses."
    }
  }
}
