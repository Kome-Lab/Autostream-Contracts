{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.autostream.example.com/youtube-output.schema.json",
  "title": "YouTubeOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "mode", "created_at", "updated_at"],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": { "const": "live_api_relay_static" }
        },
        "required": ["mode"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["rtmp_url"] },
            { "required": ["stream_key_configured"] },
            { "required": ["stream_key_fingerprint"] },
            { "required": ["watch_url"] }
          ]
        }
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": ["stream_key", "live_api_dry_run", "live_api", "live_api_relay_static"]
    },
    "rtmp_url": {
      "type": "string",
      "pattern": "^rtmps://",
      "description": "RTMPS ingest URL without the stream key."
    },
    "stream_key_configured": {
      "type": "boolean"
    },
    "stream_key_fingerprint": {
      "type": "string"
    },
    "watch_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{6,32}$",
      "description": "Canonical public watch URL used by stream_key outputs. It contains no stream key or OAuth credential."
    },
    "oauth_account_id": {
      "type": "string"
    },
    "relay_binding_id": {
      "type": "string",
      "pattern": "^relay-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Non-secret fixed Encoder/Recorder relay binding identity used only by live_api_relay_static. It is not an RTMPS URL or stream key."
    },
    "reusable_live_stream_id": {
      "type": "string",
      "description": "Non-secret YouTube reusable LiveStream identity used only by live_api_relay_static. Ingestion addresses and stream keys are never returned."
    },
    "broadcast_title_template": {
      "type": "string"
    },
    "broadcast_description": {
      "type": "string"
    },
    "privacy_status": {
      "type": "string",
      "enum": ["private", "unlisted", "public"]
    },
    "latency_preference": {
      "type": "string",
      "enum": ["normal", "low", "ultra_low"]
    },
    "enable_auto_start": {
      "type": "boolean"
    },
    "enable_auto_stop": {
      "type": "boolean"
    },
    "complete_on_stop": {
      "type": "boolean",
      "description": "When true, Control Panel completes the YouTube Live broadcast during normal stream stop. Defaults to true when omitted."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
